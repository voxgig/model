

# # Service Shapes
# # --------------

sys: shape: type({})

# Service base has no defaults.
sys: shape: srv: base: {
  in: {
  }
  out: {}
  deps: {
    &: {}
  }
  api: web: {
    active: boolean
    path: {
      prefix?: string
      area?: string
      suffix?: string
    }
    method: string
    cors: {
      active: boolean
    }
  }
  env: lambda: {
    active: boolean
    timeout: integer
    handler: path: {
      prefix: string
      suffix: string
    }
  }
}


sys: shape: srv: std: $.sys.shape.srv.base & {
  api: web: {
    active: *true | boolean
    method: *'POST' | string
    cors: active: *false | boolean
    path: {
      prefix: '/api/'
      area: *'' | string
      suffix: *'' | string
    }
  }
  env: lambda: {
    active: *false | boolean
    timeout: *30 | integer
    handler: path: {
      suffix: *'.handler' | string
    }
    kind: *standard | string
  }
}


# # Javascript service defaults
sys: shape: srv: std_js: $.sys.shape.srv.std & {
  env: lambda: handler: path: {
    prefix: *'src/handler/lambda/' | string
  }
}


# Typescript service defaults
sys: shape: srv: std_ts: $.sys.shape.srv.std & {
  env: lambda: handler: path: {
    prefix: *'dist/handler/lambda/' | string
  }
}



# Entity Shapes
# -------------


sys: shape: ent: {
  id: {
    field: 'id'
  }
  field: {
    id: kind: *'Text' | string
  }
}







sys: shape: app: {
  name: string
  layout: string
}

sys: shape: part: img: {
  src: string
  svg: string
}


# app: web: basic: .sys.shape.app
